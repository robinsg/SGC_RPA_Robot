# RPA Credentials
USERNAME="your_username"
PASSWORD="your_password"

# TN5250 Configuration
TN5250_HOST="your.as400.host"
TN5250_MAP="285"
# Use "on" or "off" for SSL depending on host requirements
TN5250_SSL="on"
TN5250_DEVICE_TYPE="IBM-3477-FC"
TN5250_DEVICE_NAME="ROBOT01"

# HMC Proxy Configuration (Optional)
# If HMC_HOST is set, the robot will connect via HMC proxy on port 2301
# HMC_HOST="your.hmc.host"
# HMC_USER="your_hmc_user"
# HMC_PWD="your_hmc_password"
# HMC_SYSNAME="your_system_name"
# HMC_LPARNAME="your_lpar_name"
# HMC_SESSION_KEY="your_session_key"
# HMC_LANG="22" # Default: 22 (en_gb)
# HMC_CONNECT_MODE="2" # Default: 2 (Connect shared)
