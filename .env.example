# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RPA Credentials
USERNAME="your_username"
PASSWORD="your_password"

# TN5250 Configuration
TN5250_HOST="your.as400.host"
TN5250_MAP="285"
# Use "on" or "off" for SSL depending on host requirements
TN5250_SSL="on"
TN5250_DEVICE_TYPE="IBM-3477-FC"
TN5250_DEVICE_NAME="ROBOT01"

# HMC Proxy Configuration (Optional)
# If HMC_HOST is set, the robot will connect via HMC proxy on port 2301
# HMC_HOST="your.hmc.host"
# HMC_USER="your_hmc_user"
# HMC_PWD="your_hmc_password"
# HMC_SYSNAME="your_system_name"
# HMC_LPARNAME="your_lpar_name"
# HMC_SESSION_KEY="your_session_key"
# HMC_LANG="22" # Default: 22 (en_gb)
# HMC_CONNECT_MODE="2" # Default: 2 (Connect shared)
